@baseUrl = http://localhost:5000/api

### ==============================================================================
### 1. AUTH SETUP: ALICE (OWNER), BOB (MEMBER), CHARLIE (NON-MEMBER)
### ==============================================================================

### 1. Register Alice (Space Owner)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Alice Owner",
    "email": "alice@example.com",
    "password": "Password123!"
}

### 2. Register Bob (Space Member)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Bob Member",
    "email": "bob@example.com",
    "password": "Password123!"
}

### 3. Register Charlie (Outsider / Non-Member)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Charlie Outsider",
    "email": "charlie@example.com",
    "password": "Password123!"
}

### 4. Login as Alice (saves token cookie automatically)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

### ==============================================================================
### 2. SPACES MANAGEMENT
### ==============================================================================

### 5. Alice creates a Space
# @name createSpace
POST {{baseUrl}}/spaces
Content-Type: application/json

{
    "name": "SyncSpace Dev Team",
    "description": "Collaboration space for devs",
    "kind": "BUILDERS_CIRCLE",
    "visibility": "PUBLIC",
    "joinPolicy": "OPEN"
}

### Grab the spaceId from step 5:
@spaceId = {{createSpace.response.body.space._id}}

### 6. Alice views her spaces
GET {{baseUrl}}/spaces

### 7. Alice views the space by ID (Owner access: 200 OK)
GET {{baseUrl}}/spaces/{{spaceId}}

### 8. Login as Bob
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "bob@example.com",
    "password": "Password123!"
}

### 9. Bob tries to view Alice's space BEFORE joining
# Expect: 403 Forbidden ("Access denied: You are not a member of this space")
GET {{baseUrl}}/spaces/{{spaceId}}

### 10. Bob joins the space
# Expect: 200 OK
POST {{baseUrl}}/spaces/{{spaceId}}/join

### 11. Bob views the space AFTER joining
# Expect: 200 OK
GET {{baseUrl}}/spaces/{{spaceId}}

### 12. List all members in space
GET {{baseUrl}}/spaces/{{spaceId}}/members

### ==============================================================================
### 3. TASK CREATION (PREREQUISITE FOR COMMENTS)
### ==============================================================================

### 13. Login back as Alice (Owner) to create Task
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

### 14. Alice creates a Task in the Space
# @name createTask
POST {{baseUrl}}/tasks
Content-Type: application/json

{
    "spaceId": "{{spaceId}}",
    "title": "Build Comment Feature",
    "description": "Implement models, controllers, services, and tests for Comments",
    "priority": "HIGH",
    "deadline": "2026-12-31T23:59:59.000Z"
}

### Grab taskId from step 14:
@taskId = {{createTask.response.body.task._id}}

### 15. View the created Task
GET {{baseUrl}}/tasks/{{taskId}}

### ==============================================================================
### 4. COMMENT BUSINESS RULES & ENDPOINTS
### ==============================================================================

### 16. Login as Charlie (Non-member)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "charlie@example.com",
    "password": "Password123!"
}

### 17. Charlie (Non-member) attempts to add a comment
# Expect: 403 Forbidden ("Access denied: You must be an active member of this space to comment")
POST {{baseUrl}}/tasks/{{taskId}}/comments
Content-Type: application/json

{
    "content": "Intruder comment trying to bypass membership"
}

### 18. Charlie (Non-member) attempts to view comments for the task
# Expect: 403 Forbidden ("Access denied: You do not have permission to view comments for this task")
GET {{baseUrl}}/tasks/{{taskId}}/comments

### 19. Login as Bob (Active Member)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "bob@example.com",
    "password": "Password123!"
}

### 20. Bob tries to add comment with empty whitespace (Validation Check)
# Expect: 400 Bad Request ("Comment content cannot be empty")
POST {{baseUrl}}/tasks/{{taskId}}/comments
Content-Type: application/json

{
    "content": "     "
}

### 21. Bob adds a valid comment to the task
# @name addComment
# Expect: 201 Created
POST {{baseUrl}}/tasks/{{taskId}}/comments
Content-Type: application/json

{
    "content": "  I am working on the comments module today!  "
}

### Grab commentId from step 21:
@commentId = {{addComment.response.body.comment._id}}

### 22. Bob lists all comments for the task
# Expect: 200 OK (trimmed content, edited: false)
GET {{baseUrl}}/tasks/{{taskId}}/comments

### 23. Alice (Owner) lists comments for the task
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

### 24. Alice gets comments (Owner has permission to view)
# Expect: 200 OK
GET {{baseUrl}}/tasks/{{taskId}}/comments

### 25. Alice tries to edit Bob's comment (Ownership Rule)
# Expect: 403 Forbidden ("User not authorized to access this comment")
PATCH {{baseUrl}}/comments/{{commentId}}
Content-Type: application/json

{
    "content": "Alice trying to tamper with Bob's comment"
}

### 26. Alice tries to delete Bob's comment (Ownership Rule)
# Expect: 403 Forbidden ("User not authorized to access this comment")
DELETE {{baseUrl}}/comments/{{commentId}}

### 27. Switch back to Bob to edit his comment
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "bob@example.com",
    "password": "Password123!"
}

### 28. Bob edits his comment
# Expect: 200 OK (content updated, edited: true)
PATCH {{baseUrl}}/comments/{{commentId}}
Content-Type: application/json

{
    "content": "Updated: Finished all comment endpoints and unit tests!"
}

### 29. Bob deletes his own comment
# Expect: 200 OK ("Comment deleted successfully")
DELETE {{baseUrl}}/comments/{{commentId}}

### 30. Verify comments list is now empty
GET {{baseUrl}}/tasks/{{taskId}}/comments

### ==============================================================================
### 5. ARCHIVE & DELETED POLICY CHECKS
### ==============================================================================

### 31. Bob adds another comment to test task deletion policy
# @name addSecondComment
POST {{baseUrl}}/tasks/{{taskId}}/comments
Content-Type: application/json

{
    "content": "Comment right before task deletion"
}

@secondCommentId = {{addSecondComment.response.body.comment._id}}

### 32. Login as Alice (Owner) to delete the Task
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

### 33. Alice soft-deletes the Task
# Expect: 200 OK (lifecycleStatus: "DELETED")
DELETE {{baseUrl}}/tasks/{{taskId}}

### 34. Bob tries to add comment to DELETED Task
# Expect: 400 Bad Request ("Cannot add a comment to a deleted task")
POST {{baseUrl}}/tasks/{{taskId}}/comments
Content-Type: application/json

{
    "content": "Trying to add comment on deleted task"
}

### 35. Bob tries to edit comment on DELETED Task
# Expect: 400 Bad Request ("Cannot edit comment on a deleted task")
PATCH {{baseUrl}}/comments/{{secondCommentId}}
Content-Type: application/json

{
    "content": "Trying to edit comment on deleted task"
}

### 36. Bob tries to delete comment on DELETED Task
# Expect: 400 Bad Request ("Cannot delete comment on a deleted task")
DELETE {{baseUrl}}/comments/{{secondCommentId}}

### 37. Alice deactivates the Space
# Expect: 200 OK (status: "Inactive")
PATCH {{baseUrl}}/spaces/{{spaceId}}/deactivate

### 38. Bob tries to comment in INACTIVE Space
# Expect: 400 Bad Request ("Cannot comment in an inactive space")
POST {{baseUrl}}/tasks/{{taskId}}/comments
Content-Type: application/json

{
    "content": "Trying to comment in inactive space"
}

### ==============================================================================
### 6. REFRESH TOKEN & LOGOUT LIFECYCLE
### ==============================================================================

### 39. Login as Charlie to get new tokens
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "charlie@example.com",
    "password": "Password123!"
}

### 40. Charlie refreshes access token using refreshToken cookie
# Expect: 200 OK (new accessToken + new rotated refreshToken)
POST {{baseUrl}}/auth/refresh

### 41. Charlie logs out (clears cookies and revokes refreshToken in DB)
# Expect: 200 OK
POST {{baseUrl}}/auth/logout

### 42. Charlie tries to refresh token after logout
# Expect: 401 Unauthorized ("Invalid or revoked refresh token")
POST {{baseUrl}}/auth/refresh


### ==============================================================================
### 7. NEW SPACES ENDPOINTS & JOIN POLICIES
### ==============================================================================

### 43. Public Space view (no auth needed)
# Expect: 200 OK (safe fields + owner name + contributor stats)
GET {{baseUrl}}/spaces/public/{{spaceId}}

### 44. Alice logs back in
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

### 45. Alice creates an INVITE_ONLY space
# @name createInviteOnlySpace
POST {{baseUrl}}/spaces
Content-Type: application/json

{
    "name": "Secret Project",
    "description": "Invite only space",
    "kind": "STUDIO",
    "visibility": "PRIVATE",
    "joinPolicy": "INVITE_ONLY"
}

@inviteSpaceId = {{createInviteOnlySpace.response.body.space._id}}

### 46. Login as Charlie (outsider)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "charlie@example.com",
    "password": "Password123!"
}

### 47. Charlie tries to join INVITE_ONLY space directly
# Expect: 403 Forbidden ("This space is invite only")
POST {{baseUrl}}/spaces/{{inviteSpaceId}}/join

### 47a. Alice creates an invite link for the INVITE_ONLY space
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

# @name createInvite
POST {{baseUrl}}/spaces/{{inviteSpaceId}}/invites
Content-Type: application/json

{
    "expiresInHours": 24,
    "maxUses": 5
}

@inviteToken = {{createInvite.response.body.token}}

### 47b. Preview invite link (no auth required)
# Expect: 200 OK (name, kind, theme, ownerName)
GET {{baseUrl}}/spaces/invite/{{inviteToken}}/preview

### 47c. Charlie joins INVITE_ONLY space via invite token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "charlie@example.com",
    "password": "Password123!"
}

# Expect: 200 OK (activates membership regardless of joinPolicy)
POST {{baseUrl}}/spaces/join/{{inviteToken}}

### 48. Alice creates a REQUEST policy space
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

# @name createRequestSpace
POST {{baseUrl}}/spaces
Content-Type: application/json

{
    "name": "Request To Join Space",
    "description": "Requires approval",
    "kind": "OUR_HOME",
    "visibility": "PUBLIC",
    "joinPolicy": "REQUEST"
}

@requestSpaceId = {{createRequestSpace.response.body.space._id}}

### 49. Charlie requests to join REQUEST space
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "charlie@example.com",
    "password": "Password123!"
}

# Expect: 200 OK (member status: "PENDING")
POST {{baseUrl}}/spaces/{{requestSpaceId}}/join

### 50. Alice views PENDING member requests (owner only)
# Expect: 200 OK (returns array of pending requests with user {_id, name})
GET {{baseUrl}}/spaces/{{requestSpaceId}}/members?status=PENDING

### 50a. Charlie (non-owner) tries to view PENDING requests
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "charlie@example.com",
    "password": "Password123!"
}

# Expect: 403 Forbidden ("Only the space owner can view pending requests")
GET {{baseUrl}}/spaces/{{requestSpaceId}}/members?status=PENDING

### 50b. Login back as Alice
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

# Charlie's user ID for approval
@charlieUserId = {{charlieUserId}}

### 51. Alice approves Charlie's join request
POST {{baseUrl}}/spaces/{{requestSpaceId}}/members/{{charlieUserId}}/approve

### ==============================================================================
### 8. TASKS & ASSIGNEES ENDPOINTS
### ==============================================================================

### 52. Alice creates a new Active Task in requestSpace
# @name createActiveTask
POST {{baseUrl}}/tasks
Content-Type: application/json

{
    "spaceId": "{{requestSpaceId}}",
    "title": "Build Realtime Dashboard",
    "description": "WebSocket integration and chart components",
    "priority": "HIGH",
    "deadline": "2026-11-30T23:59:59.000Z"
}

@newTaskId = {{createActiveTask.response.body.task._id}}

### 53. Filter space tasks
# Expect: 200 OK with filtered tasks
GET {{baseUrl}}/spaces/{{requestSpaceId}}/tasks?status=TODO&priority=HIGH

### 54. PATCH task details
# Expect: 200 OK (updated title & progressStatus)
PATCH {{baseUrl}}/tasks/{{newTaskId}}
Content-Type: application/json

{
    "title": "Build Realtime Dashboard v2",
    "progressStatus": "IN_PROGRESS"
}

### 55. Assign Charlie to the task
# Expect: 200 OK (assignee added)
POST {{baseUrl}}/tasks/{{newTaskId}}/assignees
Content-Type: application/json

{
    "userId": "{{charlieUserId}}"
}

### 56. Login as Charlie to update own assignee status
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "charlie@example.com",
    "password": "Password123!"
}

### 57. Charlie updates his own assignee status to DONE
# Expect: 200 OK
PATCH {{baseUrl}}/tasks/{{newTaskId}}/assignees/me
Content-Type: application/json

{
    "status": "DONE"
}

### 58. Switch to Alice to remove Charlie from assignees
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

DELETE {{baseUrl}}/tasks/{{newTaskId}}/assignees/{{charlieUserId}}

### ==============================================================================
### 9. SUBTASKS ENDPOINTS
### ==============================================================================

### 59. Alice creates a subtask for the task
# @name createSubtask
POST {{baseUrl}}/tasks/{{newTaskId}}/subtasks
Content-Type: application/json

{
    "title": "Setup Socket.io listeners",
    "description": "Add client handlers for events",
    "assigneeId": "{{charlieUserId}}",
    "priority": "HIGH",
    "deadline": "2026-11-15T23:59:59.000Z"
}

@subtaskId = {{createSubtask.response.body.subtask._id}}

### 60. List subtasks for the task
GET {{baseUrl}}/tasks/{{newTaskId}}/subtasks

### 61. Charlie updates subtask status to DONE
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "charlie@example.com",
    "password": "Password123!"
}

PATCH {{baseUrl}}/subtasks/{{subtaskId}}
Content-Type: application/json

{
    "status": "DONE"
}

### 62. Delete subtask
DELETE {{baseUrl}}/subtasks/{{subtaskId}}

### ==============================================================================
### 10. MENTIONS & TIMELINE (GITHUB-PR STYLE)
### ==============================================================================

### 63. Charlie comments with @Alice mention
# Expect: 201 Created and Alice receives a TASK_COMMENT notification
POST {{baseUrl}}/tasks/{{newTaskId}}/comments
Content-Type: application/json

{
    "content": "Hey @Alice Owner can you review the dashboard changes?"
}

### 64. View merged Task Timeline (comments + activity events sorted chronologically)
# Expect: 200 OK with items tagged kind: "comment" | "event"
GET {{baseUrl}}/tasks/{{newTaskId}}/timeline

### ==============================================================================
### 11. USERS & PROFILES
### ==============================================================================

### 65. Get my own user info (safe fields + email + plan)
GET {{baseUrl}}/users/me

### 66. Get another user by ID (safe fields only: _id, name, createdAt - NO email)
GET {{baseUrl}}/users/{{charlieUserId}}

### 67. Get public user profile with contribution stats
# Expect: 200 OK (name, joinedAt, PUBLIC spaces with role and stats)
GET {{baseUrl}}/users/{{charlieUserId}}/profile

### ==============================================================================
### 12. NOTIFICATIONS
### ==============================================================================

### 68. Login as Alice to check notifications (she was mentioned and task was assigned)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice@example.com",
    "password": "Password123!"
}

### 69. Get unread notification count
GET {{baseUrl}}/notifications/unread-count

### 70. Get notifications list
# @name listNotifications
GET {{baseUrl}}/notifications?unread=true&page=1&limit=20

@notificationId = {{listNotifications.response.body.notifications[0]._id}}

### 71. Mark single notification as read
PATCH {{baseUrl}}/notifications/{{notificationId}}/read

### 72. Mark all notifications as read
PATCH {{baseUrl}}/notifications/read-all

### ==============================================================================
### 13. PREMIUM / ANALYTICS
### ==============================================================================

### 73. Alice attempts to view analytics on FREE plan
# Expect: 402 Payment Required ("Analytics requires a PRO subscription plan")
GET {{baseUrl}}/spaces/{{requestSpaceId}}/analytics?range=7d

### 74. Alice flips plan to PRO (dev-only toggle)
# Expect: 200 OK (plan updated to PRO)
PATCH {{baseUrl}}/users/plan
Content-Type: application/json

{
    "plan": "PRO"
}

### 75. Alice views space analytics on PRO plan
# Expect: 200 OK (tasks completed per day, completion by member, on-time rate, workload, overdue count)
GET {{baseUrl}}/spaces/{{requestSpaceId}}/analytics?range=7d

### 75a. Bob (a member on FREE plan) views space analytics
# Expect: 200 OK because the SPACE OWNER (Alice) is on PRO plan!
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "bob@example.com",
    "password": "Password123!"
}

GET {{baseUrl}}/spaces/{{requestSpaceId}}/analytics?range=7d

### 76. Alice views 30-day analytics
GET {{baseUrl}}/spaces/{{requestSpaceId}}/analytics?range=30d
